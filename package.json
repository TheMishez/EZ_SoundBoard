{
  "name": "ez-soundboard",
  "productName": "EZ Soundboard",
  "version": "1.2.0",
  "description": "Soundboard that plays sounds straight into your microphone",
  "main": "src/main/main.js",
  "author": "EZGGco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheMishez/EZ_SoundBoard.git"
  },
  "scripts": {
    "start": "electron .",
    "build:native": "cmake -S native -B native/build -A x64 && cmake --build native/build --config Release",
    "pack:streamdeck": "node tools/pack-streamdeck.js",
    "dist": "npm run build:native && npm run pack:streamdeck && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "com.ezggco.ezsoundboard",
    "productName": "EZ Soundboard",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "EZ-Soundboard-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "native/bin",
        "to": "driver",
        "filter": [
          "*.exe",
          "*.dll"
        ]
      },
      {
        "from": "build/streamdeck",
        "to": "streamdeck",
        "filter": [
          "*.streamDeckPlugin"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "TheMishez",
        "repo": "EZ_SoundBoard",
        "releaseType": "release"
      }
    ]
  }
}
