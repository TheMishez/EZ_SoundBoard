{
  "name": "ez-soundboard",
  "productName": "EZ Soundboard",
  "version": "1.1.0",
  "description": "EZ Soundboard",
  "main": "src/main/main.js",
  "author": "EZGGco",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:native": "cmake -S native -B native/build -A x64 && cmake --build native/build --config Release",
    "dist": "npm run build:native && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "com.ezggco.ezsoundboard",
    "productName": "EZ Soundboard",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "EZ-Soundboard-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "native/bin",
        "to": "driver",
        "filter": [
          "*.exe",
          "*.dll"
        ]
      }
    ]
  }
}
